{
  "name": "mdgh-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "wrangler:dev": "wrangler pages dev dist --d1=DB --r2=MEDIA --kv=SESSION",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply mdgh-applications-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mdgh-applications-db --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@astrojs/react": "^4.4.2",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.15.5",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lenis": "^1.3.15",
    "lucide-astro": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.12.3",
    "tailwindcss": "^4.1.17",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  }
}
