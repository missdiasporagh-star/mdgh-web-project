---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import {
	Sparkles,
	Users,
	Heart,
	Target,
	Crown,
	Globe,
	Plane,
	HeartHandshake,
	Megaphone,
	GraduationCap,
	Palette,
	HandHeart,
	Calendar,
	Star,
	Trophy,
	ShieldCheck,
	User,
	Phone,
	Mail,
	Globe as WebIcon,
	Check,
	Instagram,
	Facebook,
	X,
	MessageCircle
} from 'lucide-astro';
import '../styles/global.css';

// Turnstile site key for the contact form. Falls back to Cloudflare's
// always-pass test key in dev environments without env access.
const turnstileSiteKey: string =
  Astro.locals.runtime?.env?.TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---

<Layout
	title="Miss Diaspora Ghana — The Global Pageant Celebrating Heritage & Impact"
	description="Miss Diaspora Ghana is the premier pageant for young women of African descent in the diaspora — celebrating Ghanaian heritage, culture, and impact. Apply for the 2026 cycle now."
>
  <Fragment slot="head">
    <meta name="turnstile-site-key" content={turnstileSiteKey} />
  </Fragment>
	<Navigation />
	<Hero />

	<!-- Pillars Section - Premium Redesign -->
	<section id="pillars" class="relative py-32 overflow-hidden" style="background: linear-gradient(135deg, #1a1a1a 0%, #2a2520 50%, #1a1a1a 100%);">
		<!-- Enhanced Background Elements -->
		<div class="absolute inset-0">
			<div class="absolute top-1/4 left-0 w-96 h-96 bg-[#F8B92F] rounded-full blur-[150px] opacity-20"></div>
			<div class="absolute bottom-1/4 right-0 w-96 h-96 bg-[#FFD700] rounded-full blur-[150px] opacity-15"></div>
			<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-[#F8B92F]/10 to-transparent rounded-full"></div>
		</div>

		<div class="container mx-auto px-6 relative z-10">
			<!-- Section Header -->
			<div class="text-center mb-16 lg:mb-20">
				<span class="inline-flex items-center gap-3 text-[#F8B92F] uppercase tracking-[0.35em] text-xs font-bold">
					<span class="h-px w-8 bg-gradient-to-r from-transparent to-[#F8B92F]/70"></span>
					<Sparkles class="w-3.5 h-3.5" />
					Our Three Pillars
					<span class="h-px w-8 bg-gradient-to-l from-transparent to-[#F8B92F]/70"></span>
				</span>
				<h2 class="text-heading text-5xl lg:text-7xl text-white mt-5 mb-4 max-w-4xl mx-auto">
					The Foundation of <span class="gradient-text">Excellence</span>
				</h2>
				<p class="text-xl lg:text-2xl text-white/55 max-w-2xl mx-auto italic" style="font-family: 'Cormorant Garamond', serif;">
					Three core principles guide our mission to empower women across the diaspora.
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						icon: Palette,
						number: '01',
						title: 'Cultural Identity',
						description: 'Fostering a deep appreciation for African heritage among women of the diaspora through meaningful experiences and cultural immersion.'
					},
					{
						icon: GraduationCap,
						number: '02',
						title: 'Leadership Training',
						description: 'Equipping young women with essential skills, mentorship, and opportunities to thrive in their communities and beyond.'
					},
					{
						icon: HeartHandshake,
						number: '03',
						title: 'Social Impact',
						description: 'Creating lasting change by empowering women to advocate for their communities and inspire future generations.'
					}
				].map((pillar, index) => {
					const IconComponent = pillar.icon;
					return (
						<div class="pillar-card group relative glass p-10 rounded-3xl hover:scale-[1.02] transition-all duration-500 border border-[#F8B92F]/20 hover:border-[#F8B92F]/50 overflow-hidden">
							<!-- Animated Background -->
							<div class="absolute inset-0 bg-gradient-to-br from-[#F8B92F]/0 to-[#F8B92F]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

							<!-- Number Watermark -->
							<div class="absolute top-8 right-8 text-display text-8xl font-black text-[#F8B92F]/5 group-hover:text-[#F8B92F]/10 transition-colors duration-500">
								{pillar.number}
							</div>

							<!-- Icon with Premium Styling -->
							<div class="relative z-10 mb-8">
								<div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#F8B92F] to-[#FFD700] flex items-center justify-center group-hover:scale-110 transition-transform duration-500">
									<IconComponent class="w-10 h-10 text-black" stroke-width="2" />
								</div>
							</div>

							<!-- Content -->
							<div class="relative z-10">
								<h3 class="text-heading text-3xl font-bold text-white mb-4 group-hover:text-[#F8B92F] transition-colors duration-300">
									{pillar.title}
								</h3>
								<p class="text-body-premium text-white/70 leading-relaxed">
									{pillar.description}
								</p>
							</div>

							<!-- Decorative Element -->
							<div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#F8B92F] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- About Section - Luxury Redesign -->
	<section id="about" class="relative py-32 animated-gradient grid-pattern overflow-hidden">
		<!-- Enhanced Ambient Lighting -->
		<div class="absolute inset-0">
			<div class="absolute top-1/3 right-0 w-96 h-96 bg-[#F8B92F] rounded-full blur-[150px] opacity-25"></div>
			<div class="absolute bottom-1/3 left-0 w-96 h-96 bg-[#FFD700] rounded-full blur-[150px] opacity-20"></div>
			<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-gradient-radial from-[#F8B92F]/8 to-transparent rounded-full"></div>
		</div>
		<!-- Decorative Elements -->
		<div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-transparent via-[#F8B92F]/20 to-transparent"></div>
		<div class="absolute top-0 right-1/4 w-px h-full bg-gradient-to-b from-transparent via-[#F8B92F]/20 to-transparent"></div>

		<div class="container mx-auto px-6 relative z-10">
			<div class="grid lg:grid-cols-2 gap-20 items-center">
				<!-- Image with Premium Frame -->
				<div class="about-image relative">
					<!-- Decorative Frame -->
					<div class="absolute -inset-4 bg-gradient-to-br from-[#F8B92F] via-[#FFD700] to-[#F8B92F] rounded-3xl opacity-20 blur-xl"></div>
					<div class="absolute -inset-2 border-2 border-[#F8B92F]/30 rounded-3xl"></div>

					<!-- Image Container -->
					<div class="relative rounded-3xl overflow-hidden">
						<picture>
							<source srcset="/assets/images/about_mdgh.webp" type="image/webp" />
							<img
								src="/assets/images/about_mdgh.jpg"
								alt="Miss Diaspora Ghana — the global pageant celebrating Ghanaian heritage"
								loading="lazy"
								decoding="async"
								width="500"
								height="700"
								class="w-full h-[700px] object-cover brightness-110"
							/>
						</picture>
						<!-- Overlay Gradient -->
						<div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
					</div>
				</div>

				<!-- Content -->
				<div class="space-y-8">
					<div class="inline-block">
						<span class="text-[#F8B92F] uppercase tracking-[0.3em] text-sm font-bold flex items-center gap-2">
							<Star class="w-4 h-4" />
							About MDGH
						</span>
					</div>

					<h2 class="text-heading text-6xl lg:text-7xl text-white leading-[1.1]">
						Celebrating<br />
						<span class="gradient-text">Beauty & Strength</span>
					</h2>

					<div class="space-y-6 text-body-premium text-xl text-white/70 leading-relaxed">
						<p>
							Miss Diaspora Ghana (MDGH) is dedicated to celebrating the <span class="text-white font-semibold">beauty and strength</span> of women of African descent. Our mission empowers young leaders to connect with their roots and make a lasting difference.
						</p>
						<p>
							Motivated by the rich heritage and cultural legacy of Ghana, we bridge the gap between the diaspora and their homeland through <span class="text-white font-semibold">leadership, empowerment, and cultural celebration</span>.
						</p>
					</div>

					<!-- Premium Info Cards -->
					<div class="grid grid-cols-2 gap-6 pt-8">
						<div class="glass-dark p-8 rounded-2xl border border-[#F8B92F]/20 hover:border-[#F8B92F]/50 transition-all duration-300 group">
							<div class="w-12 h-1 bg-gradient-to-r from-[#F8B92F] to-[#FFD700] mb-4 group-hover:w-full transition-all duration-500"></div>
							<span class="text-[#F8B92F] text-sm uppercase tracking-wide font-bold">Organization</span>
							<p class="text-white font-semibold mt-3 text-lg">Nubian Crown Company Limited</p>
						</div>
						<div class="glass-dark p-8 rounded-2xl border border-[#F8B92F]/20 hover:border-[#F8B92F]/50 transition-all duration-300 group">
							<div class="w-12 h-1 bg-gradient-to-r from-[#F8B92F] to-[#FFD700] mb-4 group-hover:w-full transition-all duration-500"></div>
							<span class="text-[#F8B92F] text-sm uppercase tracking-wide font-bold">General Manager</span>
							<p class="text-white font-semibold mt-3 text-lg">Yvonne Kofigah</p>
						</div>
					</div>

					<!-- Meet General Manager Button -->
					<div class="pt-8">
						<button
							id="openGMModal"
							class="group magnetic relative inline-flex items-center justify-center gap-3 px-8 py-4 bg-gradient-to-r from-[#F8B92F] to-[#FFD700] text-black font-bold text-base sm:text-lg rounded-full overflow-hidden hover:shadow-2xl hover:shadow-[#F8B92F]/50 transition-all duration-500 hover:scale-105"
						>
							<span class="relative z-10 flex items-center gap-3">
								MEET THE GENERAL MANAGER
								<User class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" />
							</span>
							<!-- Animated shine effect -->
							<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -skew-x-12 translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-1000"></div>
						</button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Objectives Section - Modern Premium Design -->
	<section id="objectives" class="relative py-32" style="background: linear-gradient(180deg, #1f1f1f 0%, #2a2520 50%, #1f1f1f 100%);">
		<!-- Ambient Lighting -->
		<div class="absolute inset-0 opacity-30">
			<div class="absolute top-0 left-1/4 w-64 h-64 bg-[#F8B92F] rounded-full blur-[120px]"></div>
			<div class="absolute bottom-0 right-1/4 w-64 h-64 bg-[#FFD700] rounded-full blur-[120px]"></div>
		</div>
		<div class="container mx-auto px-6 relative z-10">
			<!-- Section Header -->
			<div class="text-center mb-16 lg:mb-20">
				<span class="inline-flex items-center gap-3 text-[#F8B92F] uppercase tracking-[0.35em] text-xs font-bold">
					<span class="h-px w-8 bg-gradient-to-r from-transparent to-[#F8B92F]/70"></span>
					<Target class="w-3.5 h-3.5" />
					Our Mission &amp; Objectives
					<span class="h-px w-8 bg-gradient-to-l from-transparent to-[#F8B92F]/70"></span>
				</span>
				<h2 class="text-heading text-5xl lg:text-7xl text-white mt-5 mb-4">
					Driving <span class="gradient-text">Change</span>
				</h2>
				<p class="text-xl lg:text-2xl text-white/55 max-w-2xl mx-auto italic" style="font-family: 'Cormorant Garamond', serif;">
					Highlighting the invaluable role Africans abroad play in shaping national development.
				</p>
			</div>

			<!-- Objectives — editorial ledger -->
			<div class="obj-ledger max-w-5xl mx-auto grid lg:grid-cols-2 gap-x-14 xl:gap-x-20">
				{[
					{ icon: Target, num: '01', title: 'Promote Cultural Identity', description: 'Celebrate and preserve Ghanaian heritage and traditions among diaspora communities worldwide.' },
					{ icon: Crown, num: '02', title: 'Empower Young Women', description: 'Provide a platform for young women of African descent to showcase their talents and leadership potential.' },
					{ icon: Globe, num: '03', title: 'Strengthen Diaspora Engagement', description: 'Foster meaningful connections between African communities abroad and their homeland.' },
					{ icon: Plane, num: '04', title: 'Promote Tourism & Investment', description: 'Position Ghana as a vibrant destination for cultural tourism and global partnership opportunities.' },
					{ icon: Heart, num: '05', title: 'Support Social Impact', description: 'Empower contestants to champion causes such as education, health, and women\'s empowerment.' },
					{ icon: Megaphone, num: '06', title: 'Create Brand Opportunities', description: 'Offer sponsors strong visibility and engagement across diverse global audiences.' }
				].map((obj) => {
					const IconComponent = obj.icon;
					return (
						<div class="objective-card obj-row group relative flex items-start gap-5 sm:gap-6 py-7">
							<span class="obj-num">{obj.num}</span>
							<div class="flex-1 pt-1.5">
								<div class="flex items-center gap-2.5 mb-2">
									<IconComponent class="w-4 h-4 text-[#F8B92F] shrink-0" stroke-width="2" />
									<h3 class="obj-title text-heading text-xl sm:text-2xl font-semibold text-white">{obj.title}</h3>
								</div>
								<p class="text-body-premium text-white/60 leading-relaxed text-sm sm:text-base">{obj.description}</p>
							</div>
						</div>
					);
				})}
			</div>
		</div>

		<style>
			/* Objectives — ruled editorial ledger */
			.obj-row {
				border-top: 1px solid rgba(248, 185, 47, 0.14);
				padding-left: 0.25rem;
				transition: background-color 0.4s ease, padding-left 0.45s cubic-bezier(0.22, 1, 0.36, 1);
			}
			.obj-row::before {
				content: '';
				position: absolute;
				left: 0;
				top: -1px;
				bottom: 0;
				width: 2px;
				background: linear-gradient(to bottom, #F8B92F, #FFD700);
				transform: scaleY(0);
				transform-origin: top;
				transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
			}
			.obj-row:hover::before { transform: scaleY(1); }
			.obj-row:hover { padding-left: 1.1rem; }

			/* Outlined serif numeral that fills with gold on hover */
			.obj-num {
				flex-shrink: 0;
				min-width: 2.6rem;
				font-family: 'Cormorant Garamond', serif;
				font-size: 2.75rem;
				font-weight: 600;
				line-height: 1;
				color: transparent;
				-webkit-text-stroke: 1px rgba(248, 185, 47, 0.55);
				transition: color 0.4s ease, -webkit-text-stroke-color 0.4s ease;
			}
			.obj-row:hover .obj-num {
				color: #F8B92F;
				-webkit-text-stroke-color: #F8B92F;
			}

			.obj-title { transition: color 0.3s ease; }
			.obj-row:hover .obj-title { color: #F8B92F; }

			/* Closing rule under the last pair of rows */
			.obj-ledger {
				border-bottom: 1px solid rgba(248, 185, 47, 0.14);
			}

			@media (prefers-reduced-motion: reduce) {
				.obj-row, .obj-row::before, .obj-num { transition: none; }
				.obj-row:hover { padding-left: 0.25rem; }
				.obj-row:hover::before { transform: scaleY(1); }
			}
		</style>
	</section>

	<!-- Programs Section - Sophisticated Design -->
	<section id="programs" class="relative py-32 animated-gradient grid-pattern overflow-hidden">
		<!-- Enhanced Ambient Lighting -->
		<div class="absolute inset-0">
			<div class="absolute top-1/4 left-1/3 w-80 h-80 bg-[#F8B92F] rounded-full blur-[140px] opacity-25"></div>
			<div class="absolute bottom-1/4 right-1/3 w-80 h-80 bg-[#FFD700] rounded-full blur-[140px] opacity-20"></div>
			<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-gradient-radial from-[#F8B92F]/10 to-transparent rounded-full"></div>
		</div>
		<div class="container mx-auto px-6 relative z-10">
			<!-- Section Header -->
			<div class="text-center mb-16 lg:mb-20">
				<span class="inline-flex items-center gap-3 text-[#F8B92F] uppercase tracking-[0.35em] text-xs font-bold">
					<span class="h-px w-8 bg-gradient-to-r from-transparent to-[#F8B92F]/70"></span>
					<Calendar class="w-3.5 h-3.5" />
					Programs &amp; Initiatives
					<span class="h-px w-8 bg-gradient-to-l from-transparent to-[#F8B92F]/70"></span>
				</span>
				<h2 class="text-heading text-5xl lg:text-7xl text-white mt-5 mb-4">
					Our <span class="gradient-text">Journey</span>
				</h2>
				<p class="text-xl lg:text-2xl text-white/55 max-w-2xl mx-auto italic" style="font-family: 'Cormorant Garamond', serif;">
					The path from first application to crowned ambassador — every step designed to uplift.
				</p>
			</div>

			<!-- Programs — journey timeline -->
			<div class="prog-timeline relative max-w-3xl mx-auto">
				<span class="prog-spine" aria-hidden="true"></span>
				{[
					{ num: '01', icon: Users, title: 'Mentorship Program', description: 'Connects young women with experienced leaders to guide their personal and professional journeys.' },
					{ num: '02', icon: Palette, title: 'Cultural Workshops', description: 'Interactive workshops exploring Ghanaian traditions, arts, languages, and cultural practices.' },
					{ num: '03', icon: HandHeart, title: 'Community Outreach', description: 'Active engagement in local communities through impactful social initiatives and programs.' },
					{ num: '04', icon: Globe, title: 'Cultural Immersion Week', description: 'Finalists participate in cultural tours, community service, and intensive mentorship experiences.' },
					{ num: '05', icon: Star, title: 'Grand Finale Event', description: 'Professionally produced, televised finale featuring talent showcases and the crowning ceremony.' },
					{ num: '06', icon: Trophy, title: 'Post-Event Ambassadorship', description: 'One-year ambassadorial role for the crowned queen and runners-up to champion causes.' }
				].map((program) => {
					const IconComponent = program.icon;
					return (
						<div class="program-card prog-step group relative pl-20 sm:pl-24 pb-12 last:pb-0">
							<!-- Node on the spine -->
							<div class="prog-node">
								<IconComponent class="w-5 h-5 text-black" stroke-width="2.2" />
							</div>

							<!-- Step content -->
							<div class="prog-step-body">
								<span class="prog-kicker">Step {program.num}</span>
								<h3 class="prog-title text-heading text-2xl font-semibold text-white mt-1.5 mb-2">
									{program.title}
								</h3>
								<p class="text-body-premium text-white/65 leading-relaxed">
									{program.description}
								</p>
							</div>
						</div>
					);
				})}
			</div>
		</div>

		<style>
			/* Programs — journey timeline */
			.prog-spine {
				position: absolute;
				left: 23px;
				top: 10px;
				bottom: 18px;
				width: 2px;
				background: linear-gradient(
					to bottom,
					rgba(248, 185, 47, 0.05),
					rgba(248, 185, 47, 0.55) 12%,
					rgba(248, 185, 47, 0.55) 88%,
					rgba(248, 185, 47, 0.05)
				);
			}
			@media (min-width: 640px) {
				.prog-spine { left: 27px; }
			}

			.prog-node {
				position: absolute;
				left: 0;
				top: 0;
				width: 48px;
				height: 48px;
				border-radius: 9999px;
				display: flex;
				align-items: center;
				justify-content: center;
				background: linear-gradient(135deg, #F8B92F 0%, #FFD700 100%);
				box-shadow:
					0 0 0 5px #1d1a16,
					0 0 0 6px rgba(248, 185, 47, 0.28),
					0 10px 22px -8px rgba(248, 185, 47, 0.55);
				transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease;
			}
			@media (min-width: 640px) {
				.prog-node { width: 56px; height: 56px; }
			}
			.prog-step:hover .prog-node {
				transform: scale(1.08);
				box-shadow:
					0 0 0 5px #1d1a16,
					0 0 0 6px rgba(248, 185, 47, 0.5),
					0 14px 30px -8px rgba(248, 185, 47, 0.75);
			}

			.prog-kicker {
				display: inline-block;
				color: #F8B92F;
				font-family: 'Inter', sans-serif;
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.22em;
				text-transform: uppercase;
			}
			.prog-title { transition: color 0.3s ease; }
			.prog-step:hover .prog-title { color: #F8B92F; }

			@media (prefers-reduced-motion: reduce) {
				.prog-node { transition: none; }
				.prog-step:hover .prog-node { transform: none; }
			}
		</style>
	</section>

	<!-- Mid-page Apply CTA band: catches scroll-readers who haven't headed
	     for the nav. Sits between Programs and Sponsorship for narrative
	     reasons (after the visitor has read what we do, before the partnership
	     pitch). -->
	<section class="relative py-20 sm:py-24 overflow-hidden" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1410 50%, #0a0a0a 100%);">
		<div class="absolute inset-0 pointer-events-none" aria-hidden="true">
			<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[300px] bg-[#F8B92F] opacity-15 blur-[160px] rounded-full"></div>
		</div>
		<div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
			<p class="text-xs sm:text-sm uppercase tracking-[0.25em] text-[#F8B92F] font-semibold mb-4">Open casting · 2026 cycle</p>
			<h2 class="text-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
				Ready to wear the crown?
			</h2>
			<p class="text-lg sm:text-xl text-white/75 mb-10 max-w-xl mx-auto leading-relaxed">
				Applications are open to women of African descent, ages 18-35, residing outside Ghana. Begin your application in under five minutes.
			</p>
			<a
				href="/apply"
				class="magnetic group relative inline-flex items-center justify-center gap-3 px-9 sm:px-11 py-4 sm:py-5 rounded-full bg-gradient-to-r from-[#F8B92F] via-[#FFD700] to-[#ffaa3d] text-black font-bold text-base sm:text-lg shadow-xl shadow-[#F8B92F]/30 hover:shadow-[#F8B92F]/60 hover:-translate-y-0.5 transition-all duration-300"
			>
				<span>Begin Your Application</span>
