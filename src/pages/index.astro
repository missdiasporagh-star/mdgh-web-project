<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Premium scroll animations for all cards
	const animateCards = (selector: string, delay: number = 0) => {
		gsap.utils.toArray(selector).forEach((card: any, index: number) => {
			gsap.from(card, {
				scrollTrigger: {
					trigger: card,
					start: 'top bottom-=100',
					toggleActions: 'play none none reverse'
				},
				y: 60,
				opacity: 0,
				duration: 1,
				delay: delay + (index * 0.1),
				ease: 'power3.out'
			});
		});
	};

	// Animate all card sections
	animateCards('.pillar-card');
	animateCards('.objective-card');
	animateCards('.program-card');
	animateCards('.tier-card');
	animateCards('.partner-card', 0.2);

	// Animate section headers
	gsap.utils.toArray('section').forEach((section: any) => {
		const header = section.querySelector('.text-center');
		if (header) {
			gsap.from(header.children, {
				scrollTrigger: {
					trigger: header,
					start: 'top center+=200'
				},
				y: 40,
				opacity: 0,
				stagger: 0.15,
				duration: 1,
				ease: 'power3.out'
			});
		}
	});

	// Floating animation for decorative elements
	gsap.utils.toArray('.absolute.opacity-5, .absolute.opacity-10').forEach((el: any) => {
		gsap.to(el, {
			y: -30,
			duration: 3 + Math.random() * 2,
			repeat: -1,
			yoyo: true,
			ease: 'power1.inOut'
		});
	});

	// General Manager Modal Functionality
	const gmModal = document.getElementById('gmModal');
	const gmModalContent = document.getElementById('gmModalContent');
	const gmModalBackdrop = document.getElementById('gmModalBackdrop');
	const openGMModalBtn = document.getElementById('openGMModal');
	const closeGMModalBtn = document.getElementById('closeGMModal');

	// Set initial state
	gsap.set(gmModalContent, { y: 100, opacity: 0, scale: 0.95 });
	gsap.set(gmModalBackdrop, { opacity: 0 });

	// Open Modal
	function openGMModal() {
		gmModal?.classList.remove('hidden');
		document.body.style.overflow = 'hidden'; // Prevent body scroll

		// Animate backdrop
		gsap.to(gmModalBackdrop, {
			opacity: 1,
			duration: 0.3,
			ease: 'power2.out'
		});

		// Animate modal with slide up + fade in
		gsap.to(gmModalContent, {
			y: 0,
			opacity: 1,
			scale: 1,
			duration: 0.6,
			ease: 'power3.out',
			delay: 0.1
		});
	}

	// Close Modal
	function closeGMModal() {
		// Animate modal out
		gsap.to(gmModalContent, {
			y: 50,
			opacity: 0,
			scale: 0.95,
			duration: 0.4,
			ease: 'power2.in'
		});

		// Animate backdrop
		gsap.to(gmModalBackdrop, {
			opacity: 0,
			duration: 0.3,
			ease: 'power2.in',
			onComplete: () => {
				gmModal?.classList.add('hidden');
				document.body.style.overflow = ''; // Restore body scroll
			}
		});
	}

	// Event Listeners
	openGMModalBtn?.addEventListener('click', openGMModal);
	closeGMModalBtn?.addEventListener('click', closeGMModal);

	// Close on backdrop click
	gmModalBackdrop?.addEventListener('click', closeGMModal);

	// Close on ESC key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !gmModal?.classList.contains('hidden')) {
			closeGMModal();
		}
	});

	// WhatsApp Widget Animation
	const whatsappWidget = document.querySelector('.whatsapp-widget');
	if (whatsappWidget) {
		// Initial state
		gsap.set(whatsappWidget, {
			scale: 0,
			opacity: 0,
		});

		// Entrance animation
		gsap.to(whatsappWidget, {
			scale: 1,
			opacity: 1,
			duration: 0.6,
			delay: 1.5,
			ease: 'back.out(1.7)',
		});

		// Floating animation
		gsap.to(whatsappWidget, {
			y: -10,
			duration: 2,
			repeat: -1,
			yoyo: true,
			ease: 'power1.inOut',
		});
	}

	// Contact form handler is loaded as an external module — see
	// /scripts/contact-form.js. Replaces the prior inline EmailJS integration.
</script>

<script src="/scripts/contact-form.js" defer is:inline></script>
