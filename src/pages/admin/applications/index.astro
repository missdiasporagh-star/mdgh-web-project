---
import ApplyLayout from '@/layouts/ApplyLayout.astro';
import { checkAdminAuth } from '@/middleware/admin-auth';
import { listApplicationsForAdmin } from '@/lib/db/queries';

const env = Astro.locals.runtime.env;
const auth = await checkAdminAuth(Astro.request, env);
if (!auth.ok) return Astro.redirect('/admin/login');

const url = Astro.url;
const status = url.searchParams.get('status') ?? '';
const q = url.searchParams.get('q') ?? '';
const offset = Number(url.searchParams.get('offset') ?? '0');
const limit = 50;

const { rows, total } = await listApplicationsForAdmin(env.DB, {
  status: status || undefined, q: q || undefined, limit, offset,
});
---
<ApplyLayout title="Admin · Applications | MDGH">
  <div class="wrap" style="max-width:1100px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
      <h1 style="margin:0;font-size:26px">Applications ({total})</h1>
      <form id="logout-form" method="post" action="/api/admin/logout">
        <button class="btn-ghost" type="submit">Sign out</button>
      </form>
    </div>

    <!-- Cycle Settings Panel -->
    <div class="card" style="margin-bottom:18px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h2 style="margin:0;font-size:16px;color:#F8B92F;letter-spacing:0.1em;text-transform:uppercase">Cycle Settings</h2>
        <span id="cycle-save-status" style="font-size:12px;display:none"></span>
      </div>
      <div id="cycle-settings-loading" style="font-size:13px;opacity:0.7">Loading cycle settings…</div>
      <div id="cycle-settings-form" style="display:none">
        <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:end">
          <div style="flex:1;min-width:200px">
            <label class="muted" style="font-size:11px;display:block;margin-bottom:4px">Application Window</label>
            <div style="display:flex;align-items:center;gap:10px">
              <label class="switch" style="position:relative;display:inline-block;width:44px;height:24px">
                <input type="checkbox" id="cycle-toggle" style="opacity:0;width:0;height:0" />
                <span class="slider" style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#333;transition:.3s;border-radius:24px"></span>
              </label>
              <span id="cycle-status-label" style="font-size:13px;font-weight:600">Closed</span>
            </div>
          </div>
          <div style="min-width:140px">
            <label class="muted" style="font-size:11px;display:block;margin-bottom:4px">Fee (GHS)</label>
            <input class="input" id="cycle-fee" type="number" step="0.01" min="0" style="width:120px" />
          </div>
          <div style="min-width:180px">
            <label class="muted" style="font-size:11px;display:block;margin-bottom:4px">Close Date</label>
            <input class="input" id="cycle-close-date" type="datetime-local" style="width:180px" />
          </div>
          <button id="cycle-save" class="btn" type="button" style="padding:10px 18px">Save</button>
        </div>
      </div>
    </div>

    <form method="get" class="card" style="display:flex;gap:8px;flex-wrap:wrap;align-items:end">
      <div style="flex:1;min-width:200px">
        <label class="muted" style="font-size:11px">Search (email, name, reference)</label>
        <input class="input" name="q" value={q} />
      </div>
      <div>
        <label class="muted" style="font-size:11px">Status</label>
        <select class="input" name="status">
          <option value="">All</option>
          <option value="new" selected={status === 'new'}>New</option>
          <option value="reviewing" selected={status === 'reviewing'}>Reviewing</option>
          <option value="shortlisted" selected={status === 'shortlisted'}>Shortlisted</option>
          <option value="rejected" selected={status === 'rejected'}>Rejected</option>
        </select>
      </div>
      <button class="btn" type="submit" style="padding:10px 18px">Filter</button>
      <a class="btn-ghost" href="/api/admin/applications/csv" style="text-decoration:none;display:inline-block;padding:10px 14px">Export CSV</a>
    </form>

    <div class="card" style="padding:0;overflow:hidden">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="background:#0d0d0d">
            <th style="padding:10px;text-align:left;font-size:11px;color:#F8B92F;letter-spacing:0.15em;text-transform:uppercase">Submitted</th>
            <th style="padding:10px;text-align:left;font-size:11px;color:#F8B92F">Name</th>
            <th style="padding:10px;text-align:left;font-size:11px;color:#F8B92F">Email</th>
            <th style="padding:10px;text-align:left;font-size:11px;color:#F8B92F">Reference</th>
            <th style="padding:10px;text-align:left;font-size:11px;color:#F8B92F">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 && <tr><td colspan="5" style="padding:24px;text-align:center;opacity:0.6">No applications match these filters.</td></tr>}
          {rows.map((r) => (
            <tr style="border-top:1px solid #2a2a2a">
              <td style="padding:10px;font-size:13px">{r.submitted_at?.slice(0, 10) ?? '—'}</td>
              <td style="padding:10px;font-size:13px"><a href={`/admin/applications/${r.id}`}>{r.full_name ?? '(no name)'}</a></td>
              <td style="padding:10px;font-size:13px">{r.email}</td>
              <td style="padding:10px;font-size:12px;font-family:monospace;color:#F8B92F">{r.transaction_reference}</td>
              <td style="padding:10px;font-size:13px">{r.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {total > limit && (
      <div style="display:flex;gap:8px;margin-top:14px;justify-content:center">
        {offset > 0 && <a class="btn-ghost" href={`?status=${status}&q=${q}&offset=${Math.max(0, offset - limit)}`}>Previous</a>}
        {offset + limit < total && <a class="btn-ghost" href={`?status=${status}&q=${q}&offset=${offset + limit}`}>Next</a>}
      </div>
    )}
  </div>

  <style>
    .switch input:checked + .slider { background: #4ade80; }
    .switch input:focus + .slider { box-shadow: 0 0 1px #4ade80; }
    .switch .slider:before {
      position: absolute; content: "";
      height: 18px; width: 18px;
      left: 3px; bottom: 3px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }
    .switch input:checked + .slider:before { transform: translateX(20px); }
  </style>

  <script type="module">
    // Cycle settings panel
    (async () => {
      const loading = document.getElementById('cycle-settings-loading');
      const form = document.getElementById('cycle-settings-form');
      const toggle = document.getElementById('cycle-toggle');
      const statusLabel = document.getElementById('cycle-status-label');
      const feeInput = document.getElementById('cycle-fee');
      const closeDateInput = document.getElementById('cycle-close-date');
      const saveBtn = document.getElementById('cycle-save');
      const saveStatus = document.getElementById('cycle-save-status');

      let cycle = null;

      try {
        const res = await fetch('/api/admin/cycle');
        const json = await res.json();
        if (json.ok && json.cycles && json.cycles.length > 0) {
          cycle = json.cycles[0];
        }
      } catch (e) {
        loading.textContent = 'Failed to load cycle settings.';
        return;
      }

      loading.style.display = 'none';
      form.style.display = 'block';

      if (cycle) {
        toggle.checked = cycle.is_active === 1;
        statusLabel.textContent = cycle.is_active === 1 ? 'Open' : 'Closed';
        statusLabel.style.color = cycle.is_active === 1 ? '#4ade80' : '#f87171';
        feeInput.value = (cycle.application_fee_cents / 100).toFixed(2);
        if (cycle.applications_close_at) {
          // Convert ISO to datetime-local format (YYYY-MM-DDTHH:MM)
          const d = new Date(cycle.applications_close_at);
          const pad = (n) => String(n).padStart(2, '0');
          closeDateInput.value = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
        }
      }

      toggle.addEventListener('change', () => {
        statusLabel.textContent = toggle.checked ? 'Open' : 'Closed';
        statusLabel.style.color = toggle.checked ? '#4ade80' : '#f87171';
      });

      saveBtn.addEventListener('click', async () => {
        saveStatus.style.display = 'none';
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';

        const payload = {
          id: cycle.id,
          isActive: toggle.checked,
          applicationFeeCents: Math.round(parseFloat(feeInput.value || '0') * 100),
          applicationCurrency: 'GHS',
        };
        if (closeDateInput.value) {
          payload.applicationsCloseAt = new Date(closeDateInput.value).toISOString();
        }

        try {
          const res = await fetch('/api/admin/cycle', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const json = await res.json();
          if (json.ok) {
            saveStatus.textContent = 'Saved.';
            saveStatus.style.color = '#4ade80';
            saveStatus.style.display = 'inline';
            setTimeout(() => { saveStatus.style.display = 'none'; }, 2000);
          } else {
            saveStatus.textContent = json.error || 'Save failed.';
            saveStatus.style.color = '#f87171';
            saveStatus.style.display = 'inline';
          }
        } catch (e) {
          saveStatus.textContent = 'Network error.';
          saveStatus.style.color = '#f87171';
          saveStatus.style.display = 'inline';
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
        }
      });
    })();
  </script>

  <script type="module" src="/scripts/admin-applications-list.js"></script>
</ApplyLayout>
