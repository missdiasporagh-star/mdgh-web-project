---
interface Props { title: string; description?: string; }
const { title, description = 'Miss Diaspora Ghana — Application' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/assets/images/logos/md fav.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <style is:global>
    /* Reset + base */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      color: #eee;
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(ellipse 120% 70% at 50% 0%, rgba(248,185,47,0.08) 0%, transparent 50%),
        radial-gradient(ellipse 80% 60% at 100% 30%, rgba(255,215,0,0.04) 0%, transparent 50%),
        radial-gradient(ellipse 80% 60% at 0% 70%, rgba(248,185,47,0.03) 0%, transparent 50%),
        linear-gradient(180deg, #0a0a0a 0%, #0d0d0d 40%, #050505 100%);
      background-attachment: fixed;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    /* Subtle film grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      opacity: 0.04;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    }

    /* Animated background — drifting gold aurora blobs + twinkling sparkles */
    .bg-stage {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      will-change: transform;
      mix-blend-mode: screen;
    }
    .blob-1 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(248,185,47,0.55) 0%, transparent 70%);
      top: -8%; left: -10%;
      animation: drift1 28s ease-in-out infinite;
    }
    .blob-2 {
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(255,215,0,0.4) 0%, transparent 70%);
      top: 25%; right: -15%;
      animation: drift2 34s ease-in-out infinite;
    }
    .blob-3 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(255,209,102,0.5) 0%, transparent 70%);
      bottom: 5%; left: 15%;
      animation: drift3 30s ease-in-out infinite;
    }
    .blob-4 {
      width: 450px; height: 450px;
      background: radial-gradient(circle, rgba(248,185,47,0.45) 0%, transparent 70%);
      top: 55%; left: 45%;
      animation: drift4 36s ease-in-out infinite;
    }
    .blob-5 {
      width: 350px; height: 350px;
      background: radial-gradient(circle, rgba(255,235,180,0.35) 0%, transparent 70%);
      top: 75%; right: 30%;
      animation: drift5 26s ease-in-out infinite;
    }
    @keyframes drift1 {
      0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
      33% { transform: translate(18vw, 22vh) scale(1.2); opacity: 0.9; }
      66% { transform: translate(8vw, 12vh) scale(0.95); opacity: 0.6; }
    }
    @keyframes drift2 {
      0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.6; }
      50% { transform: translate(-22vw, 18vh) scale(1.25); opacity: 0.85; }
    }
    @keyframes drift3 {
      0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.65; }
      40% { transform: translate(28vw, -18vh) scale(0.85); opacity: 0.5; }
      70% { transform: translate(15vw, -8vh) scale(1.1); opacity: 0.75; }
    }
    @keyframes drift4 {
      0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.55; }
      50% { transform: translate(-18vw, -22vh) scale(1.15); opacity: 0.8; }
    }
    @keyframes drift5 {
      0%, 100% { transform: translate(0, 0) scale(0.9); opacity: 0.5; }
      50% { transform: translate(-12vw, 15vh) scale(1.1); opacity: 0.75; }
    }

    /* Twinkling sparkle dots */
    .sparkle {
      position: absolute;
      width: 3px;
      height: 3px;
      background: #FFD700;
      border-radius: 50%;
      box-shadow: 0 0 8px #FFD700, 0 0 16px rgba(255,215,0,0.6), 0 0 24px rgba(255,215,0,0.3);
      animation: twinkle 4s ease-in-out infinite;
    }
    .sparkle::before {
      content: '';
      position: absolute;
      inset: -8px;
      background: radial-gradient(circle, rgba(255,215,0,0.4) 0%, transparent 70%);
      border-radius: 50%;
    }
    .sparkle-lg { width: 5px; height: 5px; box-shadow: 0 0 12px #FFD700, 0 0 24px rgba(255,215,0,0.7), 0 0 36px rgba(255,215,0,0.4); }
    .s1  { top: 12%; left: 18%; animation-delay: 0s;   }
    .s2  { top: 28%; right: 14%; animation-delay: 1.2s; }
    .s3  { top: 45%; left: 8%;  animation-delay: 2.4s; }
    .s4  { top: 62%; right: 22%; animation-delay: 0.6s; }
    .s5  { top: 78%; left: 35%; animation-delay: 1.8s; }
    .s6  { top: 38%; left: 55%; animation-delay: 3.2s; }
    .s7  { top: 88%; right: 8%;  animation-delay: 2.8s; }
    .s8  { top: 18%; right: 38%; animation-delay: 0.9s; }
    .s9  { top: 55%; left: 78%; animation-delay: 2.1s; }
    .s10 { top: 92%; left: 52%; animation-delay: 1.5s; }
    @keyframes twinkle {
      0%, 100% { opacity: 0; transform: scale(0.5); }
      50% { opacity: 1; transform: scale(1.4); }
    }

    /* Spotlight diagonal sweep — very subtle theatrical light beam */
    .spotlight {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        115deg,
        transparent 35%,
        rgba(248,185,47,0.04) 48%,
        rgba(255,215,0,0.06) 50%,
        rgba(248,185,47,0.04) 52%,
        transparent 65%
      );
      animation: sweep 18s ease-in-out infinite;
      will-change: transform;
    }
    @keyframes sweep {
      0% { transform: translate(-30%, -30%) rotate(0deg); }
      50% { transform: translate(20%, 20%) rotate(2deg); }
      100% { transform: translate(-30%, -30%) rotate(0deg); }
    }

    @media (prefers-reduced-motion: reduce) {
      .blob, .sparkle, .spotlight { animation: none !important; }
      .sparkle { opacity: 0.6; }
    }

    h1, h2, h3 { font-family: 'Cormorant Garamond', serif; font-weight: 600; letter-spacing: -0.015em; margin: 0; line-height: 1.1; }
    h1 { font-size: clamp(40px, 6vw, 64px); }
    h2 { font-size: clamp(26px, 3.5vw, 32px); }
    h3 { font-size: clamp(18px, 2.5vw, 22px); }
    p { margin: 0; line-height: 1.6; }

    /* Display headline (Montserrat, uppercase) */
    .display {
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: clamp(11px, 1.5vw, 13px);
      color: #F8B92F;
    }
    /* Italic ceremonial line */
    .italic-display {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-weight: 500;
      color: #FFD700;
    }
    /* Gold gradient text */
    .gold-text {
      background: linear-gradient(135deg, #F8B92F 0%, #FFD700 50%, #F8B92F 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      background-size: 200% auto;
      animation: shimmer 6s ease-in-out infinite;
    }
    @keyframes shimmer {
      0%, 100% { background-position: 0% center; }
      50% { background-position: 100% center; }
    }

    /* Layout */
    .wrap { max-width: 760px; margin: 0 auto; padding: 24px 24px 96px; position: relative; z-index: 2; }
    .hero { text-align: center; padding: 64px 0 48px; position: relative; }

    /* Crown SVG container */
    .crown-icon {
      width: 56px; height: 56px;
      margin: 0 auto 24px;
      color: #F8B92F;
      filter: drop-shadow(0 0 24px rgba(248,185,47,0.5));
      animation: crown-glow 4s ease-in-out infinite;
    }
    @keyframes crown-glow {
      0%, 100% { filter: drop-shadow(0 0 24px rgba(248,185,47,0.5)); transform: translateY(0); }
      50% { filter: drop-shadow(0 0 36px rgba(248,185,47,0.8)); transform: translateY(-3px); }
    }

    /* Ornamental divider */
    .ornament {
      display: flex; align-items: center; justify-content: center; gap: 14px;
      margin: 28px auto;
      max-width: 320px;
    }
    .ornament::before, .ornament::after {
      content: ''; flex: 1; height: 1px;
      background: linear-gradient(90deg, transparent, #F8B92F, transparent);
    }
    .ornament-diamond {
      width: 8px; height: 8px;
      background: #F8B92F;
      transform: rotate(45deg);
      box-shadow: 0 0 10px rgba(248,185,47,0.6);
    }

    /* Cards */
    .card {
      background: linear-gradient(180deg, rgba(26,26,26,0.95) 0%, rgba(20,20,20,0.95) 100%);
      border: 1px solid rgba(248,185,47,0.12);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 16px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: border-color 250ms ease, transform 250ms ease;
      position: relative;
      overflow: hidden;
    }
    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(248,185,47,0.3), transparent);
    }
    .card:focus-within { border-color: rgba(248,185,47,0.35); }

    .label {
      color: #F8B92F;
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      display: inline-block;
      font-family: 'Montserrat', sans-serif;
    }
    .label::before {
      content: '— ';
      opacity: 0.6;
    }

    /* Inputs */
    .input {
      width: 100%;
      background: rgba(13,13,13,0.7);
      color: #eee;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 13px 15px;
      font: inherit;
      font-size: 15px;
      box-sizing: border-box;
      transition: all 200ms ease;
    }
    .input:focus { outline: none; border-color: #F8B92F; box-shadow: 0 0 0 3px rgba(248,185,47,0.12); }
    .input::placeholder { color: rgba(255,255,255,0.3); }

    /* Buttons */
    .btn {
      display: inline-block;
      padding: 16px 24px;
      background: linear-gradient(135deg, #F8B92F 0%, #FFD700 50%, #F8B92F 100%);
      background-size: 200% auto;
      color: #000;
      text-decoration: none;
      border: 0;
      border-radius: 12px;
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(248,185,47,0.4), 0 0 0 1px rgba(255,215,0,0.3);
      background-position: 100% center;
    }
    .btn:active:not(:disabled) { transform: translateY(0); }
    .btn:disabled { opacity: 0.3; cursor: not-allowed; filter: grayscale(0.5); }

    .btn-ghost {
      background: rgba(255,255,255,0.02);
      color: #eee;
      border: 1px solid rgba(255,255,255,0.15);
      padding: 13px 16px;
      border-radius: 10px;
      cursor: pointer;
      font: inherit;
      font-size: 14px;
      font-weight: 500;
      transition: all 200ms ease;
    }
    .btn-ghost:hover {
      border-color: rgba(248,185,47,0.6);
      background: rgba(248,185,47,0.06);
      color: #F8B92F;
    }
    .btn-ghost.selected {
      background: linear-gradient(135deg, #F8B92F, #FFD700);
      color: #000;
      border-color: transparent;
      font-weight: 700;
      box-shadow: 0 4px 16px rgba(248,185,47,0.3);
    }

    /* Pills */
    .pill {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(248,185,47,0.08);
      color: #F8B92F;
      font-family: 'Montserrat', sans-serif;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 600;
      border: 1px solid rgba(248,185,47,0.2);
    }

    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 640px) { .field-row { grid-template-columns: 1fr; } }

    .err { color: #FF6B6B; font-size: 13px; margin-top: 8px; }
    .ok { color: #4caf50; font-size: 13px; margin-top: 8px; }
    .muted { opacity: 0.65; font-size: 14px; }

    a { color: #F8B92F; text-decoration: none; transition: color 150ms ease; }
    a:hover { color: #FFD700; text-decoration: underline; }

    /* Eligibility quiz button rows */
    #eligibility-quiz > div { display: flex; flex-direction: column; }
    #eligibility-quiz > div > div { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
    #eligibility-quiz > div > div .btn-ghost { flex: 1 1 0; min-width: 80px; text-align: center; }
    #eligibility-quiz > div > div:last-child { margin-bottom: 0; }

    /* Binary toggles */
    .binary-toggle { display: flex; gap: 8px; }
    .binary-toggle .btn-ghost { flex: 1; text-align: center; }

    /* Checkbox */
    label input[type="checkbox"] { width: 18px; height: 18px; accent-color: #F8B92F; cursor: pointer; }

    /* Form sections */
    form > section { margin-bottom: 16px; }
    form > section .label + p,
    form > section .label + div { margin-top: 14px; }
    .card p + .binary-toggle, .card p + div { margin-top: 10px; }

    /* Stagger fade-in on load */
    @media (prefers-reduced-motion: no-preference) {
      .fade-up {
        animation: fadeUp 700ms cubic-bezier(0.2, 0.7, 0.1, 1) backwards;
      }
      .fade-up:nth-child(1) { animation-delay: 100ms; }
      .fade-up:nth-child(2) { animation-delay: 200ms; }
      .fade-up:nth-child(3) { animation-delay: 300ms; }
      .fade-up:nth-child(4) { animation-delay: 400ms; }
      .fade-up:nth-child(5) { animation-delay: 500ms; }
      .fade-up:nth-child(6) { animation-delay: 600ms; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <div class="bg-stage" aria-hidden="true">
    <div class="spotlight"></div>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
    <div class="blob blob-5"></div>
    <div class="sparkle sparkle-lg s1"></div>
    <div class="sparkle s2"></div>
    <div class="sparkle s3"></div>
    <div class="sparkle sparkle-lg s4"></div>
    <div class="sparkle s5"></div>
    <div class="sparkle s6"></div>
    <div class="sparkle sparkle-lg s7"></div>
    <div class="sparkle s8"></div>
    <div class="sparkle s9"></div>
    <div class="sparkle s10"></div>
  </div>
  <slot />
</body>
</html>
