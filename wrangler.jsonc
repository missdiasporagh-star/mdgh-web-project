{
  // Workers (with Assets) deploy — replaces the broken Pages CI bundler.
  // See https://developers.cloudflare.com/workers/static-assets/ for the
  // assets binding model. All bindings declared here are used at deploy
  // time (`wrangler deploy`) and at local-dev (`wrangler dev`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdgh-web-project",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-11-12",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets: serve everything in dist/ that's not _worker.js
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  },

  // Keep the workers.dev URL active alongside the custom domains.
  "workers_dev": true,

  // Unified Worker — serves the apex brand site AND the application
  // form. Previous architecture split these between the mdgh-web-project
  // Pages project (apex) and the mdgh-app Worker (apply.) — consolidated
  // into one Worker on 2026-05-22 (the Pages project was deleted; the
  // old mdgh-app Worker is retained as a safety rollback target until
  // the new Worker is verified, then deleted).
  "routes": [
    { "pattern": "missdiasporagh.org", "custom_domain": true },
    { "pattern": "www.missdiasporagh.org", "custom_domain": true },
    { "pattern": "apply.missdiasporagh.org", "custom_domain": true }
  ],

  // D1 database — created on 2026-05-06
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdgh-applications-db",
      "database_id": "0ab44066-071a-4232-acb8-83bb48a32cb3"
    }
  ],

  // R2 bucket — defaults to staging; production overrides in [env.production]
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mdgh-applications-staging"
    }
  ],

  // KV namespace — name kept as KV (NOT "SESSION") to dodge Astro 5's
  // auto-session middleware overlay
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e617b51f080c451abe6aade5373fcf6d"
    }
  ],

  // PAYAZA_BASE_URL removed — Payaza uses the SAME base URL for both test
  // and live modes (https://api.payaza.africa/live/... — the `/live/` path
  // is literal, NOT a mode switch). The src/lib/payment/payaza-provider.ts
  // hardcodes the full URL; sandbox vs live is signalled by the PKTEST vs
  // PKLIVE key prefix on PAYAZA_PUBLIC_KEY and by the `connectionMode` field
  // on the SDK bootstrap.
  "vars": {
    "R2_ACCOUNT_ID": "233d917842862e30ed5207cf7b95bc33",
    "MOCK_PAYMENTS": "false",
    "MOCK_EMAIL": "true",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },

  // Production environment: same bindings except the production R2 bucket
  "env": {
    "production": {
      "name": "mdgh-app-production",
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "mdgh-applications"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mdgh-applications-db",
          "database_id": "0ab44066-071a-4232-acb8-83bb48a32cb3"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "e617b51f080c451abe6aade5373fcf6d"
        }
      ],
      "vars": {
        "R2_ACCOUNT_ID": "233d917842862e30ed5207cf7b95bc33"
      }
    }
  }
}
